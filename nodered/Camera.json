    {
        "id": "1bf663f8280622a2",
        "type": "function",
        "z": "2454b17b.c3fa7e",
        "name": "Decode QRCode",
        "func": "const { Jimp: JimpLib } = Jimp;\nconst image = await JimpLib.read(msg.payload);\nconst { data, width, height } = image.bitmap;\n\nconst code = jsQR(new Uint8ClampedArray(data), width, height);\n\nif (code) {\n    msg.payload = code.data;\n    return msg;\n} else {\n    node.warn(\"Nem található QR-kód a képen\");\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "Jimp",
                "module": "jimp"
            },
            {
                "var": "jsQR",
                "module": "jsqr"
            }
        ],
        "x": 450,
        "y": 6920,
